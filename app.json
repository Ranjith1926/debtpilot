{
  "expo": {
    "name": "DebtPilot",
    "slug": "debtpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.debtpilot.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID for secure login"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.debtpilot.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#7C3AED"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to authenticate in DebtPilot"
        }
      ]
    ],
    "scheme": "debtpilot",
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
