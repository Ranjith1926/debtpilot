{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/emi-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/overdue",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/analytics",
      "schedule": "0 2 1 * *"
    }
  ]
}
